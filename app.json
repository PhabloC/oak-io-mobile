{
  "expo": {
    "name": "oak-io-mobile",
    "slug": "oak-io-mobile",
    "version": "1.0.0",
    "scheme": "oakio",
    "orientation": "portrait",
    "icon": "./public/logo_app.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1e1b4b",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./public/logo_app.png",
        "monochromeImage": "./public/logo_app.png"
      }
    },
    "web": {
      "favicon": "./public/logo_app.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
