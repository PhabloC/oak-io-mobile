{
  "expo": {
    "name": "OakIo",
    "slug": "oak-io-mobile",
    "version": "1.0.0",
    "scheme": "oakio",
    "orientation": "portrait",
    "icon": "./public/logo_app.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F2FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phabloc.oakio"
    },
    "android": {
      "package": "com.phabloc.oakio",
      "adaptiveIcon": {
        "backgroundColor": "#F4F2FA",
        "foregroundImage": "./public/logo_app.png",
        "monochromeImage": "./public/logo_app.png"
      }
    },
    "web": {
      "favicon": "./public/logo_app.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "7d6f4c9a-acd9-458c-b8a5-2f43424af91d"
      }
    },
    "owner": "phabloc"
  }
}
